{
  "name": "@nomadspeak/mobile-app",
  "private": true,
  "version": "1.0.0",
  "description": "NomadSpeak – English learning app for Mongolian learners",
  "scripts": {
    "test:smoke": "node --test tests/final-readiness-smoke.test.mjs",
    "cap:open:android": "npx cap open android",
    "cap:add:android": "npx cap add android",
    "android:prepare:web": "node scripts/android/prepare-web-assets.mjs",
    "android:assemble:debug": "npm run android:prepare:web && (cd android && ./gradlew assembleDebug)",
    "cap:update:android": "npx cap update android",
    "android:bundle:release": "npm run android:prepare:web && (cd android && ./gradlew bundleRelease)"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2"
  }
}
