<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center" android:width="72dp" android:height="72dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/brand_accent_start"
                android:endColor="@color/brand_accent_end" />
        </shape>
    </item>
    <item android:gravity="center" android:width="10dp" android:height="42dp" android:left="10dp" android:right="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/brand_on_accent" />
        </shape>
    </item>
    <item android:gravity="center" android:width="8dp" android:height="42dp" android:left="22dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/brand_on_accent" />
        </shape>
    </item>
    <item android:gravity="center" android:width="8dp" android:height="42dp" android:left="22dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/brand_on_accent" />
        </shape>
    </item>
</layer-list>
